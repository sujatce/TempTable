# ====================================================
# 🔹 TOKEN SERVICE CLASS
# ====================================================

class SMSTokenService:

    def __init__(
        self,
        auth_url,
        client_id,
        client_secret,
        expire_in_seconds=1770
    ):
        self.auth_url = auth_url
        self.client_id = client_id
        self.client_secret = client_secret
        self.expire_in = timedelta(seconds=expire_in_seconds)
        self.token = None
        self.expire_at = datetime.now(timezone.utc)

    def token_valid(self):
        return (
            self.token
            and datetime.now(timezone.utc) < self.expire_at
        )

    def renew_token(self):

        if not self.token_valid():

            logging.info("[AUTH] Requesting new access token...")

            payload = {
                "grant_type": "client_credentials",
                "client_id": self.client_id,
                "client_secret": self.client_secret
            }

            try:

                response = session.post(
                    self.auth_url,
                    data=payload,
                    timeout=20
                )

                logging.info(
                    f"[AUTH] Response Status: {response.status_code}"
                )

                if response.status_code == 200:

                    data = response.json()
                    self.token = data["access_token"]

                    self.expire_at = (
                        datetime.now(timezone.utc)
                        + self.expire_in
                    )

                    logging.info(
                        "[AUTH] ✅ Access token received."
                    )

                else:

                    raise Exception(
                        f"[AUTH ERROR] "
                        f"{response.status_code}: "
                        f"{response.text}"
                    )

            except requests.exceptions.RequestException as e:

                raise Exception(
                    f"[AUTH ERROR] Request failed: {e}"
                )

    def get_headers(self):

        self.renew_token()

        return {
            "Authorization": f"Bearer {self.token}",
            "Accept": "application/json"
        }


# ====================================================
# 🔹 DATE PARSING FUNCTION
# ====================================================

def parse_api_datetime(value):
    """
    Convert an API timestamp into a timezone-aware datetime.

    Example:
    2026-06-22T09:38:54Z
    """

    if not value:
        return None

    try:
        return datetime.fromisoformat(
            str(value).replace("Z", "+00:00")
        )

    except (ValueError, TypeError):

        logging.warning(
            f"[DATE] Unable to parse performed-at value: {value}"
        )

        return None


# ====================================================
# 🔹 BULK UNSUBSCRIBE FETCHER CLASS
# ====================================================

class BulkUnsubscribeFetcher:

    def __init__(
        self,
        api_base_url,
        program_id,
        token_service
    ):
        self.api_base_url = api_base_url
        self.program_id = program_id
        self.token_service = token_service

    def fetch_last_sent_template(
        self,
        phone_id,
        program_id
    ):
        """
        Fetch last sent outbound message template
        for a phone/program.
        """

        empty_result = {
            # "LAST_OUTBOUND_MESSAGE_ID": None,
            "LAST_TEMPLATE_ID": None,
            # "LAST_MESSAGE_STATUS": None,
            # "LAST_MESSAGE_CREATED_AT": None,
            # "LAST_MESSAGE_UPDATED_AT": None
        }

        if not phone_id or not program_id:
            return empty_result

        endpoints = [
            "outbound-messages",
            "outbound-messages-archive"
        ]

        for endpoint in endpoints:

            url = (
                f"{self.api_base_url}/{endpoint}?"
                f"phone-id={phone_id}"
                f"&program-id={program_id}"
                f"&page=1"
                f"&per-page=50"
                f"&sort-by=created-at"
                f"&sort-order=desc"
            )

            try:

                response = session.get(
                    url,
                    headers=self.token_service.get_headers(),
                    timeout=30
                )

                logging.info(
                    f"[{endpoint.upper()}] "
                    f"Phone ID {phone_id} "
                    f"Status Code: {response.status_code}"
                )

                if response.status_code == 401:

                    self.token_service.renew_token()

                    response = session.get(
                        url,
                        headers=self.token_service.get_headers(),
                        timeout=30
                    )

                if response.status_code != 200:

                    logging.warning(
                        f"[{endpoint.upper()}] "
                        f"Unable to fetch messages "
                        f"for phone-id={phone_id}"
                    )

                    continue

                data = response.json()

                messages = (
                    data.get("outbound-message")
                    or data.get("outbound-message-archive")
                    or data.get("outbound-message-archives")
                    or data.get("outbound-messages")
                    or data.get("outbound-messages-archive")
                    or data.get("outbound-messages-archives")
                    or data.get("outboundMessages")
                    or data.get("messages")
                    or []
                )

                logging.info(
                    f"[{endpoint.upper()}] "
                    f"Message count for phone-id={phone_id}: "
                    f"{len(messages)}"
                )

                for msg in messages:

                    logging.info(
                        f"[{endpoint.upper()} DEBUG] "
                        f"Message record:\n"
                        f"{json.dumps(msg, indent=2)}"
                    )

                    generated_body = (
                        msg.get("generated-body") or ""
                    ).lower()

                    service_response = (
                        msg.get("service-response") or ""
                    ).lower()

                    template_id = str(
                        msg.get("template-id") or ""
                    ).replace(".0", "")

                    if (
                        "unsubscribed" in generated_body
                        or "unsubscribed" in service_response
                    ):

                        logging.info(
                            f"[{endpoint.upper()}] "
                            f"Skipping unsubscribe confirmation "
                            f"template-id="
                            f"{msg.get('template-id')}"
                        )

                        continue

                    if (
                        template_id == "1788197"
                        and "welcome to wellmed cares"
                        in generated_body
                    ):

                        logging.info(
                            f"[{endpoint.upper()}] "
                            f"Skipping Welcome "
                            f"template-id={template_id}"
                        )

                        continue

                    logging.info(
                        f"[{endpoint.upper()}] "
                        f"Selected template-id="
                        f"{msg.get('template-id')}"
                    )

                    return {
                        # "LAST_OUTBOUND_MESSAGE_ID":
                        # msg.get("id"),

                        "LAST_TEMPLATE_ID": template_id,

                        # "LAST_MESSAGE_STATUS":
                        # msg.get("status"),

                        # "LAST_MESSAGE_CREATED_AT":
                        # msg.get("created-at"),

                        # "LAST_MESSAGE_UPDATED_AT":
                        # msg.get("updated-at")
                    }

            except requests.exceptions.RequestException as e:

                logging.error(
                    f"[{endpoint.upper()} ERROR] "
                    f"{str(e)}"
                )

        return empty_result

    def fetch_all_unsubscribed(
        self,
        start_datetime,
        end_datetime
    ):
        """
        Fetch unsubscribed records occurring after
        start_datetime and through end_datetime.
        """

        unsubscribed = []
        page = 1
        per_page = 1000

        # report_generated_date = (
        #     datetime.now(timezone.utc)
        #     .strftime("%Y-%m-%dT%H:%M:%SZ")
        # )

        while True:

            url = (
                f"{self.api_base_url}/subscriptions?"
                f"program-id={self.program_id}"
                f"&status=unsubscribed"
                f"&page={page}"
                f"&per-page={per_page}"
            )

            logging.info(
                f"[FETCH] 📄 Fetching page {page}..."
            )

            try:

                response = session.get(
                    url,
                    headers=self.token_service.get_headers(),
                    timeout=30
                )

                logging.info(
                    f"[FETCH] Status Code: "
                    f"{response.status_code}"
                )

                if response.status_code == 401:

                    logging.info(
                        "[AUTH] Token expired — retrying..."
                    )

                    self.token_service.renew_token()
                    continue

                if response.status_code != 200:

                    logging.warning(
                        f"[FETCH] ⚠️ Unexpected response: "
                        f"{response.status_code}"
                    )

                    break

                data = response.json()

                subs = (
                    data.get("subscription")
                    or []
                )

                if page == 1 and subs:

                    logging.info(
                        f"[DEBUG] Sample unsubscribed entry:\n"
                        f"{json.dumps(subs[0], indent=2)}"
                    )

                if not subs:

                    logging.info(
                        "[FETCH] ✅ No more records found."
                    )

                    break

                for s in subs:

                    metadata = s.get("metadata", {})

                    gmpi_id = metadata.get("gmpi_id")
                    phone_id = s.get("phone-id")
                    status = s.get("status")
                    source = s.get("source")
                    performed_at = s.get("performed-at")
                    created_at = s.get("created-at")
                    updated_at = s.get("updated-at")
                    program_id = s.get("program-id")

                    if status != "unsubscribed":
                        continue

                    performed_datetime = (
                        parse_api_datetime(performed_at)
                    )

                    if performed_datetime is None:

                        logging.warning(
                            f"[DATE] Skipping record because "
                            f"performed-at is missing or invalid. "
                            f"GMPI_ID={gmpi_id}, "
                            f"PHONE_ID={phone_id}"
                        )

                        continue

                    # Keep only records AFTER
                    # 2026-06-22 09:38:54.
                    if performed_datetime <= start_datetime:
                        continue

                    # Do not include records beyond
                    # the current report execution time.
                    if performed_datetime > end_datetime:
                        continue

                    logging.info(
                        f"[DELTA] Including "
                        f"GMPI_ID={gmpi_id}, "
                        f"performed-at={performed_at}"
                    )

                    last_template_info = (
                        self.fetch_last_sent_template(
                            phone_id,
                            program_id
                        )
                    )

                    unsubscribed.append({
                        "GMPI_ID": gmpi_id,
                        "PHONE_ID": phone_id,
                        "STATUS": status,
                        "SOURCE": source,
                        "UNSUBSCRIBE_PERFORMED_DATE":
                            performed_at,
                        "PHONE_CREATED_DATE": created_at,
                        "PHONE_UPDATED_DATE": updated_at,
                        "PROGRAM_ID": program_id,

                        # "REPORT_GENERATED_DATE":
                        # report_generated_date,

                        # "LAST_OUTBOUND_MESSAGE_ID":
                        # last_template_info[
                        #     "LAST_OUTBOUND_MESSAGE_ID"
                        # ],

                        "LAST_TEMPLATE_ID":
                            last_template_info[
                                "LAST_TEMPLATE_ID"
                            ],

                        # "LAST_MESSAGE_STATUS":
                        # last_template_info[
                        #     "LAST_MESSAGE_STATUS"
                        # ],

                        # "LAST_MESSAGE_CREATED_AT":
                        # last_template_info[
                        #     "LAST_MESSAGE_CREATED_AT"
                        # ],

                        # "LAST_MESSAGE_UPDATED_AT":
                        # last_template_info[
                        #     "LAST_MESSAGE_UPDATED_AT"
                        # ]
                    })

                metadata_info = (
                    data.get("metadata", {})
                    .get("pagination", {})
                )

                total_pages = int(
                    metadata_info.get(
                        "total-pages",
                        page
                    )
                )

                if page >= total_pages:
                    break

                page += 1
                time.sleep(0.5)

            except requests.exceptions.RequestException as e:

                logging.error(
                    f"[FETCH ERROR] {str(e)}"
                )

                break

        logging.info(
            f"[FETCH] ✅ Total unsubscribed records "
            f"retrieved after "
            f"{start_datetime.isoformat()}: "
            f"{len(unsubscribed)}"
        )

        return unsubscribed


