SELECT DISTINCT
    [mrm].[GMPI_ID],
    [mrm].[CONTRACT_PBP] AS [PBP],
    [mrm].[NPI_ID] AS [PCP_NPI],
    [mrm].[CONTRACT_ID],
    CONCAT([mrm].[CONTRACT_ID], '-', [mrm].[CONTRACT_PBP]) AS [CONTRACT_PBP],
    [mrm].[REPORT_MONTH] AS [REPORT_MONTH],
    CASE
        WHEN [dc].[CLINIC_RELATION] = 'Affiliated' THEN 'Affiliated'
        WHEN [mrm].[OWNED_FLAG] = 1 THEN 'Owned'
        WHEN [mrm].[OWNED_FLAG] = 0 THEN 'Contracted'
        ELSE ''
    END AS [PROVIDER_RELATION]
FROM [BI_Analysis].[dbo].[MEMBER_REPORT_MONTH] AS [mrm]
INNER JOIN [BI_Analysis].[dbo].[DIM_PROVIDER] AS [dp]
    ON [mrm].[NPI_ID] = [dp].[NPI_ID]
INNER JOIN [BI_Analysis].[dbo].[DIM_CLINIC] AS [dc]
    ON [dp].[CLINIC_ID] = [dc].[CLINIC_ID]
WHERE [mrm].[DATA_ENTITY] = 'WellMed'
  AND [mrm].[REPORT_MONTH] = (
        SELECT MAX([rm].[REPORT_MONTH])
        FROM [BI_Analysis].[dbo].[MEMBER_REPORT_MONTH] AS [rm]
        WHERE [rm].[DATA_ENTITY] = 'WellMed'
    )
  AND [mrm].[ACTIVE_FLAG] = 1;
