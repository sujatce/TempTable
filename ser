CREATE OR REPLACE TEMP TABLE DBO.tmp_OPTUM_LGC_HLK_cjb AS
select DISTINCT a.participantid
,k.KED_2
,K.KED_DATERESULTREPORTED
,k.KED_DATESENT
,K.KED_RESULT
,g.A1C_2
,g.A1C_DATERESULTREPORTED
,g.A1C_DATESENT
,g.A1C_RESULT
,F.IFOBT
,F.IFOBT_DATERESULTREPORTED
,F.IFOBT_DATESENT
,F.IFOBT_RESULT
,U.UACR
,U.UACR_DATERESULTREPORTED
,U.UACR_DATESENT
,U.UACR_RESULT
--UNRETURNED_KIT_COUNT
, ( IFF(k.KED_2 ILIKE 'Y' AND k.KED_DATERESULTREPORTED IS NULL, 1, 0) + IFF(g.A1C_2 ILIKE 'Y' AND g.A1C_DATERESULTREPORTED IS NULL, 1, 0) + IFF(f.IFOBT ILIKE 'Y' AND f.IFOBT_DATERESULTREPORTED IS NULL, 1, 0) + IFF(u.UACR ILIKE 'Y' AND u.UACR_DATERESULTREPORTED IS NULL, 1, 0) ) AS UNRETURNED_KIT_COUNT
--RETURNED_KIT_COUNT
, ( IFF(k.KED_2 ILIKE 'Y' AND k.KED_DATERESULTREPORTED IS not NULL, 1, 0) + IFF(g.A1C_2 ILIKE 'Y' AND g.A1C_DATERESULTREPORTED IS not NULL, 1, 0) + IFF(f.IFOBT ILIKE 'Y' AND f.IFOBT_DATERESULTREPORTED IS not NULL, 1, 0) + IFF(u.UACR ILIKE 'Y' AND u.UACR_DATERESULTREPORTED IS not NULL, 1, 0) ) AS RETURNED_KIT_COUNT
-- (Total Kits)
,( IFF(k.KED_2 ILIKE 'Y' , 1, 0) + IFF(g.A1C_2 ILIKE 'Y' , 1, 0) + IFF(f.IFOBT ILIKE 'Y' , 1, 0) + IFF(u.UACR ILIKE 'Y' , 1, 0)
) AS TOTAL_KITS
--RESULTS
, ( IFF(k.KED_2 ILIKE 'Y' AND k.KED_RESULT IS NOT NULL, 1, 0) + IFF(g.A1C_2 ILIKE 'Y' AND g.A1C_RESULT IS NOT NULL, 1, 0) + IFF(f.IFOBT ILIKE 'Y' AND f.IFOBT_RESULT IS NOT NULL, 1, 0) + IFF(u.UACR ILIKE 'Y' AND u.UACR_RESULT IS NOT NULL, 1, 0) ) AS RESULTS ,CASE WHEN (CASE WHEN k.KED_2 = 'Y' THEN 1 ELSE 0 END + CASE WHEN g.A1C_2 = 'Y' THEN 1 ELSE 0 END + CASE WHEN F.IFOBT = 'Y' THEN 1 ELSE 0 END + CASE WHEN U.UACR = 'Y' THEN 1 ELSE 0 END ) &gt;= 2 THEN 'Y' ELSE 'N' END AS MULTI_KIT_FLAG from DBO.tmp_OPTUM_LGC_HLK_MBRS a left join DBO.tmp_OPTUM_LGC_HLK_MBRS_KDB1 k on a.participantid = k.participantid left join DBO.tmp_OPTUM_LGC_HLK_MBRS_GLCS g on a.participantid = g.participantid left join DBO.tmp_OPTUM_LGC_HLK_MBRS_FCIT F on a.participantid = F.participantid left join DBO.tmp_OPTUM_LGC_HLK_MBRS_UACR U on a.participantid = U.participantid ;
