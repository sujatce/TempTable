CREATE OR REPLACE TEMP TABLE DBO.tmp_COB_POLY_DETAIL AS WITH COB AS ( SELECT DISTINCT A.MBI , A.ENTERPRISE_INDV_ID , A.MEASURE_YEAR , A.NUMERATOR AS COB_NUMERATOR_FLAG , A.GAP_STATUS AS COB_GAP_STATUS , A.MEASURE_INDICATOR AS COB_MEASURE_INDICATOR , A.CONCURRENT_USE_DAYS AS COB_OVERLAPPING_DAYS , A.MOST_RECENT_FILL_DATE_FOR_MEDICATION AS COB_MOST_RECENT_FILL_DATE , A.MEDICATION AS COB_MED_NAME , A.DAYS_SUPPLY AS COB_DAYS_SUPPLY , A.PRESCRIBER_NPI AS COB_PRESCRIBER_ID , A.PRESCRIBER_NM AS COB_PRESCRIBER_NAME , A.PHARMACY_NPI AS COB_PHARMACY_ID , A.PHARMACY_NM AS COB_PHARMACY_NAME , A.NDC AS COB_NDC , MBR.OC_FLAG , MBR.OC_BUSINESS_SEGMENT , MBR.OC_CDO , MBR.OC_EMP_STATUS , MBR.OC_SEGMENT FROM MNREY_PRD_BEAKER_DB_WELLMED_ASQN_SH_DB.BEAKER_ACCESS.VW_REPORT_RX_COB_PACH_MDE_MBR_DTL A INNER JOIN ( SELECT MBI, OC_FLAG, BUSINESS_SEGMENT AS OC_BUSINESS_SEGMENT, OC_CDO, OC_EMP_STATUS, SEGMENT AS OC_SEGMENT FROM MNREY_PRD_BEAKER_DB_WELLMED_ASQN_SH_DB.BEAKER_ACCESS.VW_MEMBERSHIP WHERE OC_FLAG = TRUE ) MBR ON MBR.MBI = A.MBI WHERE A.MEASURE_YEAR = YEAR(CURRENT_DATE()) AND OC_CDO != 'WellMed' AND MSR_ABR = 'COB' QUALIFY ROW_NUMBER() OVER (PARTITION BY A.MBI ORDER BY CAST(A.MOST_RECENT_FILL_DATE_FOR_MEDICATION AS DATE) DESC NULLS LAST, A.DAYS_SUPPLY DESC NULLS LAST, A.PRESCRIBER_NPI NULLS LAST) = 1
),
ACH AS ( SELECT DISTINCT A.MBI , A.ENTERPRISE_INDV_ID , A.MEASURE_YEAR , A.NUMERATOR AS POLY_ACH_NUMERATOR_FLAG , A.GAP_STATUS AS POLY_ACH_GAP_STATUS , A.MEASURE_INDICATOR AS POLY_ACH_MEASURE_INDICATOR , A.CONCURRENT_USE_DAYS AS POLY_ACH_OVERLAPPING_DAYS , A.MOST_RECENT_FILL_DATE_FOR_MEDICATION AS POLY_ACH_MOST_RECENT_FILL_DATE , A.MEDICATION AS POLY_ACH_MED_NAME , A.DAYS_SUPPLY AS POLY_ACH_DAYS_SUPPLY , A.PRESCRIBER_NPI AS POLY_ACH_PRESCRIBER_ID , A.PRESCRIBER_NM AS POLY_ACH_PRESCRIBER_NAME , A.PHARMACY_NPI AS POLY_ACH_PHARMACY_ID , A.PHARMACY_NM AS POLY_ACH_PHARMACY_NAME , A.NDC AS POLY_ACH_NDC , MBR.OC_FLAG , MBR.OC_BUSINESS_SEGMENT , MBR.OC_CDO , MBR.OC_EMP_STATUS , MBR.OC_SEGMENT FROM MNREY_PRD_BEAKER_DB_WELLMED_ASQN_SH_DB.BEAKER_ACCESS.VW_REPORT_RX_COB_PACH_MDE_MBR_DTL A INNER JOIN ( SELECT MBI, OC_FLAG, BUSINESS_SEGMENT AS OC_BUSINESS_SEGMENT, OC_CDO, OC_EMP_STATUS, SEGMENT AS OC_SEGMENT FROM MNREY_PRD_BEAKER_DB_WELLMED_ASQN_SH_DB.BEAKER_ACCESS.VW_MEMBERSHIP WHERE OC_FLAG = TRUE ) MBR ON MBR.MBI = A.MBI WHERE A.MEASURE_YEAR = YEAR(CURRENT_DATE()) AND OC_CDO != 'WellMed' AND MSR_ABR = 'POLY_ACH' QUALIFY ROW_NUMBER() OVER (PARTITION BY A.MBI ORDER BY CAST(A.MOST_RECENT_FILL_DATE_FOR_MEDICATION AS DATE) DESC NULLS LAST, A.DAYS_SUPPLY DESC NULLS LAST, A.PRESCRIBER_NPI NULLS LAST) = 1
) SELECT COALESCE(C.MBI, A.MBI) AS MBI , COALESCE(C.ENTERPRISE_INDV_ID, A.ENTERPRISE_INDV_ID) AS ENTERPRISE_INDV_ID , COALESCE(C.MEASURE_YEAR, A.MEASURE_YEAR) AS MEASURE_YEAR , CASE WHEN C.MBI IS NOT NULL AND A.MBI IS NOT NULL THEN 'BOTH' WHEN C.MBI IS NOT NULL THEN 'COB' ELSE 'POLY_ACH' END AS COB_POLY_MEASURE , COALESCE(C.OC_FLAG, A.OC_FLAG) AS OC_FLAG , COALESCE(C.OC_BUSINESS_SEGMENT, A.OC_BUSINESS_SEGMENT) AS OC_BUSINESS_SEGMENT , COALESCE(C.OC_CDO, A.OC_CDO) AS OC_CDO , COALESCE(C.OC_EMP_STATUS, A.OC_EMP_STATUS) AS OC_EMP_STATUS , COALESCE(C.OC_SEGMENT, A.OC_SEGMENT) AS OC_SEGMENT
-- Combined measure fields (COB value | POLY_ACH value when BOTH)
, IFF(C.MBI IS NOT NULL AND A.MBI IS NOT NULL, CONCAT_WS(' | ', TO_VARCHAR(C.COB_NUMERATOR_FLAG), TO_VARCHAR(A.POLY_ACH_NUMERATOR_FLAG)), COALESCE(TO_VARCHAR(C.COB_NUMERATOR_FLAG), TO_VARCHAR(A.POLY_ACH_NUMERATOR_FLAG))) AS NUMERATOR_FLAG , IFF(C.MBI IS NOT NULL AND A.MBI IS NOT NULL, CONCAT_WS(' | ', C.COB_GAP_STATUS, A.POLY_ACH_GAP_STATUS), COALESCE(C.COB_GAP_STATUS, A.POLY_ACH_GAP_STATUS)) AS GAP_STATUS , IFF(C.MBI IS NOT NULL AND A.MBI IS NOT NULL, CONCAT_WS(' | ', C.COB_MEASURE_INDICATOR, A.POLY_ACH_MEASURE_INDICATOR), COALESCE(C.COB_MEASURE_INDICATOR, A.POLY_ACH_MEASURE_INDICATOR)) AS MEASURE_INDICATOR , IFF(C.MBI IS NOT NULL AND A.MBI IS NOT NULL, CONCAT_WS(' | ', TO_VARCHAR(C.COB_OVERLAPPING_DAYS), TO_VARCHAR(A.POLY_ACH_OVERLAPPING_DAYS)), COALESCE(TO_VARCHAR(C.COB_OVERLAPPING_DAYS), TO_VARCHAR(A.POLY_ACH_OVERLAPPING_DAYS))) AS OVERLAPPING_DAYS , IFF(C.MBI IS NOT NULL AND A.MBI IS NOT NULL, CONCAT_WS(' | ', TO_VARCHAR(C.COB_MOST_RECENT_FILL_DATE), TO_VARCHAR(A.POLY_ACH_MOST_RECENT_FILL_DATE)), COALESCE(TO_VARCHAR(C.COB_MOST_RECENT_FILL_DATE), TO_VARCHAR(A.POLY_ACH_MOST_RECENT_FILL_DATE))) AS MOST_RECENT_FILL_DATE , IFF(C.MBI IS NOT NULL AND A.MBI IS NOT NULL, CONCAT_WS(' | ', C.COB_MED_NAME, A.POLY_ACH_MED_NAME), COALESCE(C.COB_MED_NAME, A.POLY_ACH_MED_NAME)) AS MED_NAME , IFF(C.MBI IS NOT NULL AND A.MBI IS NOT NULL, CONCAT_WS(' | ', TO_VARCHAR(C.COB_DAYS_SUPPLY), TO_VARCHAR(A.POLY_ACH_DAYS_SUPPLY)), COALESCE(TO_VARCHAR(C.COB_DAYS_SUPPLY), TO_VARCHAR(A.POLY_ACH_DAYS_SUPPLY))) AS DAYS_SUPPLY , IFF(C.MBI IS NOT NULL AND A.MBI IS NOT NULL, CONCAT_WS(' | ', C.COB_PRESCRIBER_ID, A.POLY_ACH_PRESCRIBER_ID), COALESCE(C.COB_PRESCRIBER_ID, A.POLY_ACH_PRESCRIBER_ID)) AS PRESCRIBER_ID , IFF(C.MBI IS NOT NULL AND A.MBI IS NOT NULL, CONCAT_WS(' | ', C.COB_PRESCRIBER_NAME, A.POLY_ACH_PRESCRIBER_NAME), COALESCE(C.COB_PRESCRIBER_NAME, A.POLY_ACH_PRESCRIBER_NAME)) AS PRESCRIBER_NAME , IFF(C.MBI IS NOT NULL AND A.MBI IS NOT NULL, CONCAT_WS(' | ', C.COB_PHARMACY_ID, A.POLY_ACH_PHARMACY_ID), COALESCE(C.COB_PHARMACY_ID, A.POLY_ACH_PHARMACY_ID)) AS PHARMACY_ID , IFF(C.MBI IS NOT NULL AND A.MBI IS NOT NULL, CONCAT_WS(' | ', C.COB_PHARMACY_NAME, A.POLY_ACH_PHARMACY_NAME), COALESCE(C.COB_PHARMACY_NAME, A.POLY_ACH_PHARMACY_NAME)) AS PHARMACY_NAME , IFF(C.MBI IS NOT NULL AND A.MBI IS NOT NULL, CONCAT_WS(' | ', C.COB_NDC, A.POLY_ACH_NDC), COALESCE(C.COB_NDC, A.POLY_ACH_NDC)) AS NDC FROM COB C
FULL OUTER JOIN ACH A ON A.MBI = C.MBI
;
