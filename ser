-- AND CAST(MAH_Den AS VARCHAR) IN ( '1')
AND PriorityCategory IN ('31-40 gap days remaining', '41-50 gap days remaining', '&gt;50 gap days remaining') ) THEN 'Med Adh-Priority13'
-- Priority 15: If patient is in the denominator and open numerator for SUPD AND has a current reversed statin claim for MY, assign to RPh.
WHEN ( CAST(SUPD AS VARCHAR) IN ('0', 'NC') AND CAST(SUPD_Den AS VARCHAR) IN ( '1') and REVERSAL_DATE &lt;&gt; '' ) THEN 'RPh-Priority15'
-- Priority 16: If patient is in the denominator and open numerator for SUPD AND part of MAC denominator in prior MY, assign to RPh.
WHEN (CAST(SUPD AS VARCHAR) IN ('0', 'NC') AND CAST(SUPD_Den AS VARCHAR) IN ( '1') AND "Runoff_MAC_Denom" IN ('1')) THEN 'RPh-Priority16'
-- Priority 17: If patient is in the denominator and open numerator for Poly-ACH, Assign to RPh
WHEN (CAST(Poly_ACH AS VARCHAR) IN ('0', 'NC') AND CAST(Poly_ACH_Den AS VARCHAR) IN ( '1')) THEN 'RPh-Priority17'
-- Priority 18: If patient is in the denominator and open numerator for Poly-ACH, Assign to RPh
WHEN (CAST(COB AS VARCHAR) IN ('0', 'NC') AND CAST(COB_Den AS VARCHAR) IN ( '1')) THEN 'RPh-Priority18'
-- Priority 19 LTR single fills
WHEN ( One_Fill = 'Y' AND Member_Type = 'LATE TO REFILL' ) THEN 'Med Adh-Priority19'
--Priority 20 Refill reminder ( Blast)
WHEN Member_Type = 'REFILL REMINDER' THEN 'Med Adh-Priority20'
-- Priority 21 Refill reminder single fill (Blast)
WHEN ( One_Fill = 'Y' AND Member_Type = 'REFILL REMINDER' ) THEN 'Med Adh-Priority21'
-- Priority 22: CBP - Open Numerator (0 or NC) and Denominator (1)
WHEN (CAST(CBP AS VARCHAR) IN ('0', 'NC') AND CAST(CBP_Den AS VARCHAR) IN ( '1')) THEN 'RN-Priority22'
-- Default: No match
ELSE 'Unassigned-Priority23'
END AS Assigned_To_Priority
