
SELECT DISTINCT
    RAW.MAAT2_MA_PDC_MED_ADH_RAW_ID,
    RAW.GMPI_ID,
    RAW.MBI,
    RAW.ENTERPRISE_INDV_ID AS EID,
    MRM.MEMBER_LAST_NAME,
    MRM.MEMBER_FIRST_NAME,
    COALESCE(MRM.MBR_DATE_OF_BIRTH, RAW.DATE_OF_BIRTH) AS MEMBER_DATE_OF_BIRTH,
    RAW.DATE_OF_DEATH AS MEMBER_DATE_OF_DEATH,
    COALESCE(MRM.CONTRACT_ID, RAW.CONTRACT) AS CONTRACT_ID,
    COALESCE(MRM.CONTRACT_PBP, RAW.PBP) AS CONTRACT_PBP,
    RAW.ENROLL_BEGIN_DATE,
    RAW.ENROLL_END_DATE,
    RAW.PLAN_TERMINATION_DATE,
    RAW.ENCRYPT,
    RAW.HOSPICE_FLAG,
    RAW.ESRD_FLAG,
    RAW.NON_CONT_ENROL_FLAG,
    RAW.MEASURE,
    RAW.DETERMINATION,
    RAW.CURRENT_PDC,
    RAW.ALLOWABLE_DAYS,
    RAW.ALLOWABLE_DAYS_REMAINING,
    RAW.DAYS_TO_FAILURE,
    RAW.ABSOLUTE_FAIL_DATE,
    RAW.MEDICATION,
    RAW.NDC_CD,
    RAW.FIRST_FILL_DATE,
    RAW.LAST_FILL_DATE,
    RAW.DAYS_SUPPLY,
    RAW.REFILL_DUE_DATE,
    RAW.MED_QUANTITY,
    RAW.NUMBER_OF_REFILLS_REMAINING,
    RAW.NUMBER_OF_REFILLS_AUTH,
    RAW.DATE_PRESCRIPTION_WRITTEN,
    RAW.RX_NUMBER,
    RAW.RUN_OUT_FLAG,
    RAW.ENTRESTO_FLAG,
    RAW.INSULIN_FLAG,
    RAW.IPSNF_ADJ_FLAG,
    RAW.PHARMACY_NPI,
    RAW.PHARMACY_NAME,
    RAW.PHARMACY_PHONE,
    RAW.RETAIL_FLG,
    RAW.MAIL_ORDER_FLG,
    RAW.PRESCRIBER_ID,
    RAW.PRESCRIBER_LAST_NAME,
    RAW.PRESCRIBER_FIRST_NAME,
    RAW.DATA_FOLDER,
    RAW.REFRESH_DATE

FROM ASQN_PRD_ORCHESTRATION_DB.RAW.MAAT2_MA_PDC_MED_ADH_RAW RAW

LEFT JOIN (
    SELECT *
    FROM FWRB_PRD_WMIDR_DB.BI_ANALYSIS.MEMBER_REPORT_MONTH
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY GMPI_ID
        ORDER BY REPORT_MONTH DESC
    ) = 1
) MRM
    ON MRM.GMPI_ID = RAW.GMPI_ID
    AND MRM.REPORT_MONTH = DATE_TRUNC('MONTH', RAW.REFRESH_DATE)

WHERE RAW.REFRESH_DATE >= DATEADD(DAY, -7, CURRENT_DATE())

AND NOT EXISTS (
    SELECT 1
    FROM ASQN_PRD_ORCHESTRATION_DB.CLEANSED.WM_MAAT_MEDADH_CLNSD CLNSD
    WHERE CLNSD.MAAT2_MA_PDC_MED_ADH_RAW_ID =
          RAW.MAAT2_MA_PDC_MED_ADH_RAW_ID
);
